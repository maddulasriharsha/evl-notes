# Copy to .env.local (and add the same two values in Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API. The anon / publishable key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: verify new accounts by emailing a 6-digit code (Brevo free plan: 300 emails a day).
# Without these, accounts are created without email verification. See docs/SIGNUP_EMAIL.md.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
